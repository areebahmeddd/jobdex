# The API edge (Caddy) sets its own headers; these apply only to the static site.
# `payment` is intentionally unrestricted, and COOP allows popups for the cross-origin Razorpay checkout.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups

# Vite content-hashes everything under /assets, so it can be cached forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
